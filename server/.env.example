# =============================================================
# Unified Environment Configuration Template
# Copy this file to server/.env (or root .env) and fill in your credentials.
# NEVER commit .env to source control (.gitignore).
# =============================================================

# ── Gemini / Almanac AI Configuration ────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite
AI_DEV_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-flash-lite
AI_PROXY_URL=

# ── Proxy Server Settings ────────────────────────────────────
PORT=8787
RATE_LIMIT_PER_HOUR=30
TRUST_PROXY=0

# ── Firebase Project Configuration ───────────────────────────
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
